APP_ENV=development
SUPERTOKENS_APP_NAME=Enterprise Auth RBAC
SUPERTOKENS_API_DOMAIN=
SUPERTOKENS_WEBSITE_DOMAIN=
SUPERTOKENS_CONNECTION_URI=
SUPERTOKENS_API_KEY=
SUPERTOKENS_AUTH_METHOD=email_password
# Server secret for hashing API keys. Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_HMAC_SECRET=
# false = audit-only rollout (log would-be denials but allow the request)
AUTH_ENFORCE=true
# Corporate IdP bearer tokens (all three required to enable)
OAUTH2_ISSUER=
OAUTH2_AUDIENCE=
OAUTH2_JWKS_URI=
OAUTH2_GROUP_CLAIM=groups
# JSON map of IdP group -> gateway role, e.g. {"AI-Platform-Admins":"admin"}
OAUTH2_ROLE_MAP={}
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# --- Semantic cache + model router (served by the same app, behind the auth layer) ---
PINECONE_API_KEY=
PINECONE_INDEX=semantic-cache
PINECONE_NAMESPACE=semantic-cache
PINECONE_SIMILARITY_THRESHOLD=0.90
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_SIMPLE_MODEL=qwen2.5:3b
OLLAMA_REASONING_MODEL=qwen2.5:14b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_BASELINE_MODEL=qwen2.5:14b
CACHE_TTL_SECONDS=3600
CACHE_MAX_RESPONSE_CHARS=40000
AB_TEST_ENABLED=false
AB_TEST_TREATMENT_PERCENT=50
# Candidates are only compared within a category; include models adequate for that category.
MODEL_CANDIDATES_JSON={}
MODEL_PRICES_JSON={}
METRICS_DB_PATH=./data/metrics.sqlite3
# Optional ordered rules, e.g. [{"category":"coding","pattern":"\b(python|typescript)\b"}]
ROUTING_RULES_JSON=
# Streamlit demo client (streamlit run streamlit_app.py): API URL and a gk_... API key
STREAMLIT_API_URL=http://127.0.0.1:8000
STREAMLIT_API_KEY=

# Protect the stand-alone SemanticCaching&ModelRoutingLayer app instead of the embedded copy.
# That app must run with AUTH_ENABLED=false on this loopback address (only the gateway may reach it).
# SEMANTIC_UPSTREAM_URL=http://127.0.0.1:8012
